# Backend runtime database. Use the Atlas URI after a successful migration.
MONGODB_URI=mongodb://127.0.0.1:27017/psifu

# Migration only. Do not commit real Atlas credentials.
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017
ATLAS_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/psifu?retryWrites=true&w=majority
DB_NAME=psifu
PORT=4000

# SMTP is required for PSIFU to deliver verification and password-reset OTPs.
# For Gmail, turn on 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="PSIFU <your-email@gmail.com>"
